<Window x:Class="GestiónIncidenciasTécnicas.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestiónIncidenciasTécnicas"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--TÍTULO-->
        <Label Grid.Row="0" Content="INCIDENCIA" FontSize="20" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Título:" FontSize="14" Margin="10" FontWeight="DemiBold"/>
            <TextBlock Name="txtTitulo" FontSize="14" Margin="10"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label Content="Categoría:" FontSize="14" Margin="10" FontWeight="DemiBold"/>
            <TextBlock Name="txtCategoria" FontSize="14" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
