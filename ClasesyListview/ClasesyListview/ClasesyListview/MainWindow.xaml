<Window x:Class="ClasesyListview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClasesyListview"
        mc:Ignorable="d"
        Title="MainWindow" Height="760" Width="850" MinHeight="650" MinWidth="750">
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock Grid.Row="0"
                       Text="Panel de preferencias"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- DATOS -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NOMBRE -->
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Content="Nombre:"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         x:Name="txtNombre"
                         Margin="5"
                         TextChanged="TxtNombre_TextChanged"/>

                <Label Grid.Row="0"
                       Grid.Column="2"
                       x:Name="lblVistaNombre"
                       Margin="10,5"/>

                <!-- EDAD -->
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Content="Edad:"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         x:Name="txtEdad"
                         Margin="5"/>

                <!-- PERFIL -->
                <Label Grid.Row="2"
                       Grid.Column="0"
                       Content="Perfil:"/>

                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          x:Name="cbPerfil"
                          Margin="5"
                          SelectionChanged="CbPerfil_SelectionChanged">

                    <ComboBoxItem Content="Personal"/>
                    <ComboBoxItem Content="Trabajo"/>
                    <ComboBoxItem Content="Estudio"/>

                </ComboBox>

                <Label Grid.Row="2"
                       Grid.Column="2"
                       x:Name="lblPerfil"
                       Content="Sin seleccionar"
                       Margin="10,5"/>

            </Grid>

            <!-- OPCIONES -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MODALIDAD -->
                <GroupBox Grid.Column="0"
                          Header="Modalidad"
                          Margin="0,0,10,0">

                    <StackPanel Margin="10">

                        <RadioButton x:Name="rbBasico"
                                     Content="Básica"
                                     GroupName="Modalidad"
                                     Margin="0,5"/>

                        <RadioButton x:Name="rbAvanzado"
                                     Content="Avanzada"
                                     GroupName="Modalidad"
                                     Margin="0,5"/>

                    </StackPanel>

                </GroupBox>

                <!-- PREFERENCIAS -->
                <GroupBox Grid.Column="1"
                          Header="Preferencias"
                          Margin="10,0,0,0">

                    <StackPanel Margin="10">

                        <CheckBox x:Name="chkNotificaciones"
                                  Content="Recibir notificaciones"
                                  Checked="chkNotificaciones_Checked"
                                  Unchecked="chkNotificaciones_Unchecked"
                                  Margin="0,5"/>

                        <Label x:Name="lblAviso"
                               Content="Notificaciones activadas"
                               Visibility="Collapsed"/>

                    </StackPanel>

                </GroupBox>

            </Grid>

            <!-- NIVEL -->
            <GroupBox Grid.Row="3"
                      Header="Nivel"
                      Margin="0,0,0,15">

                <StackPanel Margin="10">

                    <Slider x:Name="slNivel"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            ValueChanged="SlNivel_ValueChanged"/>

                    <ProgressBar x:Name="pbNivel"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="20"
                                 Margin="0,10,0,5"/>

                    <Label x:Name="lblNivel"
                           Content="Nivel: 0"/>

                </StackPanel>

            </GroupBox>

            <!-- BOTONES -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">

                <Button x:Name="btnSaludar"
                        Content="Saludar"
                        Width="100"
                        Margin="5"
                        Click="BtnSaludar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="100"
                        Margin="5"
                        Click="BtnGuardar_Click"/>

                <Button x:Name="btnResumen"
                        Content="Ver resumen"
                        Width="110"
                        Margin="5"
                        Click="BtnResumen_Click"/>

                <Button x:Name="btnLimpiar"
                        Content="Limpiar"
                        Width="100"
                        Margin="5"
                        Click="BtnLimpiar_Click"/>

            </StackPanel>

            <!-- PERSONAS GUARDADAS -->
            <Grid Grid.Row="5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Header="Personas guardadas">

                    <ListView x:Name="lvPersonas"
                              Height="180"
                              Margin="10">

                        <ListView.View>

                            <GridView>

                                <GridViewColumn Header="Nombre"
                                                Width="180"
                                                DisplayMemberBinding="{Binding Nombre}"/>

                                <GridViewColumn Header="Edad"
                                                Width="80"
                                                DisplayMemberBinding="{Binding Edad}"/>

                                <GridViewColumn Header="Perfil"
                                                Width="150"
                                                DisplayMemberBinding="{Binding Perfil}"/>

                                <GridViewColumn Header="Modalidad"
                                                Width="150"
                                                DisplayMemberBinding="{Binding Modalidad}"/>

                            </GridView>

                        </ListView.View>

                    </ListView>

                </GroupBox>

                <Label Grid.Row="1"
                       x:Name="lblMensaje"
                       FontWeight="Bold"
                       Margin="0,10,0,0"/>

            </Grid>

        </Grid>

    </ScrollViewer>
</Window>
