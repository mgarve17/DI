<Window x:Class="Ventanas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ventanas"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <TextBlock Grid.Row="0"
               Text="Panel de preferencias"
               FontSize="26"
               FontWeight="Bold"
               Margin="0,0,0,15"/>


        <!-- DATOS DEL USUARIO -->

        <GroupBox Grid.Row="1"
              Header="Datos del usuario"
              Margin="0,5">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- NOMBRE -->

                <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="Nombre:"/>

                <TextBox Grid.Row="0"
                     Grid.Column="1"
                     x:Name="txtNombre"
                     Margin="5"
                     TextChanged="TxtNombre_TextChanged"/>


                <!-- VISTA PREVIA -->

                <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="Vista previa:"/>

                <Label Grid.Row="1"
                   Grid.Column="1"
                   x:Name="lblVistaNombre"
                   Content="-"
                   Margin="5"/>


                <!-- EDAD -->

                <Label Grid.Row="2"
                   Grid.Column="0"
                   Content="Edad:"/>

                <TextBox Grid.Row="2"
                     Grid.Column="1"
                     x:Name="txtEdad"
                     Margin="5"/>


                <!-- PERFIL -->

                <Label Grid.Row="3"
                   Grid.Column="0"
                   Content="Perfil:"/>

                <ComboBox Grid.Row="3"
                      Grid.Column="1"
                      x:Name="cbPerfil"
                      Margin="5"
                      SelectionChanged="CbPerfil_SelectionChanged">

                    <ComboBoxItem Content="Personal"/>
                    <ComboBoxItem Content="Trabajo"/>
                    <ComboBoxItem Content="Estudio"/>

                </ComboBox>


                <!-- PERFIL SELECCIONADO -->

                <Label Grid.Row="4"
                   Grid.Column="1"
                   x:Name="lblPerfil"
                   Content="Sin seleccionar"
                   Margin="5"/>

            </Grid>

        </GroupBox>


        <!-- PREFERENCIAS -->

        <GroupBox Grid.Row="2"
              Header="Preferencias"
              Margin="0,10">

            <StackPanel Margin="10">


                <!-- NOTIFICACIONES -->

                <CheckBox x:Name="chkNotificaciones"
                      Content="Mostrar notificaciones"
                      Margin="5"
                      Checked="chkNotificaciones_Checked" 
                      />

                <Label x:Name="lblAviso"
                   Content="Las notificaciones están activadas"
                   Visibility="Collapsed"
                   Margin="5"/>


                <!-- MODALIDAD -->

                <TextBlock Text="Modalidad:"
                       Margin="5,15,5,5"
                       FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal"
                        Margin="5">

                    <RadioButton x:Name="rbBasico"
                             Content="Básico"
                             GroupName="Modalidad"
                             Margin="5"/>

                    <RadioButton x:Name="rbAvanzado"
                             Content="Avanzado"
                             GroupName="Modalidad"
                             Margin="5"/>

                </StackPanel>


                <!-- NIVEL -->

                <TextBlock Text="Nivel:"
                       Margin="5,15,5,5"
                       FontWeight="SemiBold"/>

                <ProgressBar x:Name="pbNivel"
                         Minimum="0"
                         Maximum="100"
                         Height="20"
                         Margin="5"/>

                <Slider x:Name="slNivel"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    Margin="5"
                    ValueChanged="SlNivel_ValueChanged"/>

                <Label x:Name="lblNivel"
                   Content="Nivel: 0"
                   Margin="5"/>

            </StackPanel>

        </GroupBox>


        <!-- BOTONES -->

        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,15,0,0">

            <Button x:Name="btnSaludar"
                Content="Saludar"
                Width="100"
                Margin="5"
                Click="BtnSaludar_Click"/>

            <Button x:Name="btnGuardar"
                Content="Guardar"
                Width="100"
                Margin="5"
                Click="BtnGuardar_Click"/>

            <Button x:Name="btnLimpiar"
                Content="Limpiar"
                Width="100"
                Margin="5"
                Click="BtnLimpiar_Click"/>

            <Button x:Name="btnResumen"
                Content="Ver Resumen"
                Width="110"
                Margin="5"
                Click="BtnResumen_Click"/>
        </StackPanel>


        <!-- MENSAJE -->

        <Label Grid.Row="4"
           x:Name="lblMensaje"
           FontSize="18"
           Margin="5"/>

    </Grid>
</Window>
