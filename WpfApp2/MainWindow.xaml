<Window x:Class="FichaAlumno.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:FichaAlumno" mc:Ignorable="d" Title="Ficha de alumno" Height="527" Width="822">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Ficha del alumno" Style="{StaticResource tituloPrincipal}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Datos Personales" Grid.Row="0" Grid.Column="0">
                <StackPanel>
                    <Label Content="Nombre: "/>
                    <TextBox  x:Name="txtNombre"/>
                    <Label Content="Apellidos: "/>
                    <TextBox x:Name="txtApelliedos"/>
                    <Label Content="Fecha de nacimiento:"/>
                    <DatePicker x:Name="dpFecha" SelectedDateFormat="Long"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="1" Grid.Column="0">
                <Label Content="Curso: "/>
                <ComboBox x:Name="cmbCurso" SelectedIndex="1">
                    <ComboBoxItem Content="DAM 1"/>
                    <ComboBoxItem Content="DAM 2"/>
                    <ComboBoxItem Content="DAW 1"/>
                    <ComboBoxItem Content="DAW 2"/>
                </ComboBox>
            </StackPanel>
            <GroupBox Header="Modalidad" Margin="0,15,0,0" Grid.Row="0" Grid.Column="1">
                <StackPanel>
                    <RadioButton Content="Presencial" GroupName="Modalidad" IsChecked="True"/>
                    <RadioButton Content="Distancia" GroupName="Modalidad" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Preferencias" Margin="0,15,0,0" Grid.Row="1" Grid.Column="1">
                <StackPanel>
                    <CheckBox Content="Recibir avisos" IsChecked="True"/>
                    <CheckBox Content="Recibir recordatorios"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <WrapPanel Grid.Row="2">
            <Button Content="Guardar" Width="100" Margin="0,20,0,0" ToolTip="Guardar los datos del alumno"/>
            <Button Content="Limpiar" Width="100" Margin="0,20, 0,0" ToolTip="Limpiar el formulario"/>
        </WrapPanel>
    </Grid>
</Window>