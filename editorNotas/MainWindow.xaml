<Window x:Class="editorNotas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:editorNotas"
        mc:Ignorable="d"
        Title="Editor de notas" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top"> <!--MENÚ PRINCIPAL-->
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nuevo" InputGestureText="Ctrl+N">
                    <MenuItem Header="Documento de texto"/>
                    <MenuItem Header="Ventana"/>
                </MenuItem>
                <MenuItem Header="Abrir..." InputGestureText="Ctrl+O"/>
                <MenuItem Header="Guardar" IsEnabled="False" InputGestureText="Ctrl+S">
                    <MenuItem Header="Guardar como..."/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="salir" InputGestureText="Ctrl+E" Click="Salir_Click">

                    <MenuItem.Icon>
                        <Image Source="/imagenes/wallpaper2you_290665.jpg" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edición">
                <MenuItem Command="ApplicationCommands.Cut"/>
                <MenuItem Command="ApplicationCommands.Copy"/>
                <MenuItem Command="ApplicationCommands.Paste"/>
            </MenuItem>
            <MenuItem Header="Ver">
                <MenuItem Header="Ajustes de línea" IsCheckable="True"/>
                <MenuItem Header="Barra de estado" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Ayuda">
                <MenuItem Header="ver ayuda"/>
                <Separator/>
                <MenuItem Header="Acerca de"/>

            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top"> <!--BARRA DE HERRAMIENTAS-->
            <ToolBar>
                <Button Content="Nuevo"/>
                <Button Content="Abrir"/>
                <Button Content="Guardar"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <!--BARRA DE ESTADO-->
            <StatusBarItem>
                <TextBlock Text="Listo"/>
            </StatusBarItem>
        </StatusBar>

        <TextBox x:Name="textEditor" 
            AcceptsReturn="True" 
            TextWrapping="Wrap" 
            Padding="10" 
            ContextMenu="{StaticResource MenuEdicion}">
        </TextBox>
    </DockPanel>
</Window>
