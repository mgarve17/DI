<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource FondoPrincipal}"/>
    </Style>
    
    <!--botones-->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource FondoBoton}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordes}"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Margin" Value="5"/>
     </Style>

    <!--Labels-->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="FontFamily" Value="Verdana"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <!--TextBox-->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontFamily" Value="Verdana"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    
    <!--ComboBox-->

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
        <Setter Property="Margin" Value="5"/>
    </Style>


</ResourceDictionary>