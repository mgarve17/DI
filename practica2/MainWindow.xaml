<Window x:Class="practica2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practica2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Archivo">
                <MenuItem Header="Nuevo" Click="Nuevo_Click"/>
                <MenuItem Header="Abrir" Click="Abrir_Click"/>
                <MenuItem Header="Guardar" Click="Guardar_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Click="Salir_Click"/>
            </MenuItem>
            <MenuItem Header="Tareas">
                <MenuItem Header="Añadir tarea"/>
                <MenuItem Header="Editar tarea"/>
                <MenuItem Header="Eliminar tarea"/>
            </MenuItem>
            <MenuItem Header="Ayuda">
                <MenuItem Header="Ver ayuda"/>
                <MenuItem Header="Acerca de"/>
            </MenuItem>
        </Menu>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="FILTROS" Grid.Column="0" Grid.Row="0" Margin="5">
                <StackPanel>
                    
                    <Label Content="Estado:" FontWeight="Bold" Margin="5"/>
                    
                    <ComboBox SelectionChanged="FiltroComboBox_SelectionChanged" Margin="5">
                        <ComboBoxItem Content="Todas"/>
                        <ComboBoxItem Content="Pendientes"/>
                        <ComboBoxItem Content="En curso"/>
                        <ComboBoxItem Content="Completadas"/>
                    </ComboBox>
                    
                    <Label Content="Prioridad:" FontWeight="Bold" Margin="5"/>
                    
                    <RadioButton Content="Todas" GroupName="Prioridad" Margin="5"/>
                    <RadioButton Content="Alta" GroupName="Prioridad" Margin="5"/>
                    <RadioButton Content="Media" GroupName="Prioridad" Margin="5"/>
                    <RadioButton Content="Baja" GroupName="Prioridad" Margin="5"/>
                    
                    <Button Content="Aplicar filtros" Margin="5"/>
                </StackPanel>


            </GroupBox>

            <StackPanel Grid.Column="1" Grid.Row="0" Margin="5">
                <TextBlock Text="Detalles" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="DetallesTextBlock" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="auto" Margin="0,10,0,0">
                    <Label Content="Título: " Margin="0,0,5,0"/>
                    <TextBox x:Name="TituloTextBox" Width="200" HorizontalAlignment="Left" Margin="5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="auto" Margin="0,10,0,0">
                    <Label Content="Descripción: " Margin="0,0,5,0"/>
                    <TextBox x:Name="DescripcionTextBox" Width="200" HorizontalAlignment="Left" Margin="5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="auto" Margin="0,10,0,0">
                    <Label Content="Fecha de vencimiento: " Margin="0,0,5,0"/>
                    <DatePicker x:Name="FechaVencimientoDatePicker" Width="200" HorizontalAlignment="Left" Margin="5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="auto" Margin="0,10,0,0">
                    <Label Content="Prioridad: " Margin="0,0,5,0"/>
                    <ComboBox x:Name="PrioridadComboBox" Width="200" HorizontalAlignment="Left" Margin="5">
                        <ComboBoxItem Content="Alta"/>
                        <ComboBoxItem Content="Media"/>
                        <ComboBoxItem Content="Baja"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StatusBar Grid.Column="0" Grid.Row="1">
                <StatusBarItem>
                    <TextBlock x:Name="StatusTextBlock" Text="Listo"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

     
    </DockPanel>
   
</Window>
