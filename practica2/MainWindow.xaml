<Window x:Class="practica2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practica2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Archivo">
                <MenuItem Header="Nuevo" />
                <MenuItem Header="Abrir"/>
                <MenuItem Header="Guardar"/>
                <Separator/>
                <MenuItem Header="Salir"/>
            </MenuItem>
            <MenuItem Header="Tareas">
                <MenuItem Header="Añadir tarea"/>
                <MenuItem Header="Editar tarea"/>
                <MenuItem Header="Eliminar tarea"/>
            </MenuItem>
            <MenuItem Header="Ayuda">
                <MenuItem Header="Ver ayuda"/>
                <MenuItem Header="Acerca de"/>
            </MenuItem>
            
        </Menu>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="FILTROS" Grid.Column="0" Grid.Row="0" Margin="5">
                
                <StackPanel>

                    <Label Content="Estado:" FontWeight="Bold" Margin="5"/>

                    <ComboBox  Margin="5">
                        <ComboBoxItem Content="Todas"/>
                        <ComboBoxItem Content="Pendientes"/>
                        <ComboBoxItem Content="En curso"/>
                        <ComboBoxItem Content="Completadas"/>
                    </ComboBox>

                    <Label Content="Prioridad:" FontWeight="Bold" Margin="5"/>

                    <RadioButton Content="Todas" GroupName="Prioridad" Margin="5"/>
                    <RadioButton Content="Alta" GroupName="Prioridad" Margin="5"/>
                    <RadioButton Content="Media" GroupName="Prioridad" Margin="5"/>
                    <RadioButton Content="Baja" GroupName="Prioridad" Margin="5"/>

                    <Button Content="Aplicar filtros" Margin="5"/>
                </StackPanel>


            </GroupBox>

            <StackPanel Grid.Column="1" Grid.Row="0" Margin="5">
                <TextBlock Text="Detalles" FontSize="20" FontWeight="Bold" Margin="5"/>
                <TextBlock x:Name="DetallesTextBlock" TextWrapping="Wrap"/>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="0,10,0,0">
                        <Label Content="Título" Margin="0,10,0,0"/>
                        <Label Content="Descripción" Margin="0,10,0,0"/>
                        <Label Content="Fecha de vencimiento" Margin="0,12,0,0"/>
                        <Label Content="Prioridad" Margin="0,20,0,0"/>


                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" Width="auto" Margin="0,12,0,12">
                        <TextBox x:Name="TituloTextBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBox x:Name="DescripcionTextBox" Width="200" Height="23"  HorizontalAlignment="Left" Margin="0,10,0,12"/>
                        <DatePicker x:Name="FechaVencimientoDatePicker" Width="200" HorizontalAlignment="Left" Margin="0,10,0,12"/>
                        <ComboBox x:Name="PrioridadComboBox" Width="200" HorizontalAlignment="Left" Margin="0,10,0,10">
                            <ComboBoxItem Content="Alta"/>
                            <ComboBoxItem Content="Media"/>
                            <ComboBoxItem Content="Baja"/>
                        </ComboBox>

                    </StackPanel>

                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="auto">
                    <Button Content="Guardar" Width="100"  Margin="0,0,0,0"/>
                    <Button Content="Limpiar" Width="100"  Margin="10,0,0,0"/>
                    <Button Content="Cerrar" Width="100"  Margin="10,0,10,0"/>
                </StackPanel>
            </StackPanel>
            <StatusBar  Grid.Row="2" Grid.ColumnSpan="2" DockPanel.Dock="Bottom">
                <StatusBarItem>
                    
                    <Grid Width="800">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Usuario: Invitado " Grid.Column="0" Width="auto"/>
                        <TextBlock Text="0 Tareas" Grid.Column="1" HorizontalAlignment="Right" Width="auto"/>
                        
                    </Grid>
                </StatusBarItem>
            </StatusBar>

        </Grid>
        
    </DockPanel>
   
</Window>
